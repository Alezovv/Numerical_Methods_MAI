# --- Prerequisites ---
# Файлы, зависящие от платформы
*.o
*.obj
*.exe
*.out
*.app

# --- Build directories ---
# Игнорируем папку сборки, которая видна на скриншоте
build/
build*/
cmake-build-*/

# --- CMake artifacts ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# --- IDE / Editor settings ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
.vs/

# JetBrains (CLion, etc.)
.idea/

